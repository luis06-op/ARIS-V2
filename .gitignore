# --- Laravel / PHP ---
/vendor/
/bootstrap/cache/*.php
/storage/*.key
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache

# --- Entorno y secretos ---
.env
.env.*
!.env.example
/config/*local*.php
/auth.json

# --- Node / Vite ---
/node_modules/
/public/build/
/public/hot
/public/storage
npm-debug.log*
yarn-error.log*

# --- Almacenamiento privado y artefactos académicos ---
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/*.sqlite
/database/*.sqlite

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
!.vscode/extensions.json
/.nova/
/.zed/
.phpactor.json
_ide_helper.php
Homestead.json
Homestead.yaml
/storage/pail
/public/fonts-manifest.dev.json

# --- Herramientas de agentes ---
/.opencode/
/opencode.json
/AGENT-*.md
/.agents/
/.codex
/.cursor/

# --- Artefactos de empaquetado y respaldos locales ---
/dist/
/builds/
*.zip
*.tar.gz
*.sql
*.dump
!/database/**/*.sql
