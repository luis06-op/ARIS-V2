# ARIS 2.0 — plantilla de configuración de entorno.
# Copiar a .env y completar los valores. NUNCA versionar .env.
# Este archivo no contiene secretos reales.

APP_NAME="ARIS 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8099

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos SINTÉTICA del proyecto. No apuntar a bases de otros proyectos.
# MySQL/MariaDB es el motor objetivo del producto.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aris2_dev
DB_USERNAME=aris2_dev
DB_PASSWORD=
# Atajo de laboratorio cuando no hay servidor MySQL disponible (no usar para validar
# migraciones de producción): DB_CONNECTION=sqlite y DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Zona horaria institucional usada para presentar fechas (no para almacenarlas).
# Se confirma con la institución antes de un piloto (PI-009).
ARIS_INSTITUTION_TIMEZONE=America/Bogota

# Límite de carga en aplicación; debe ser coherente con php.ini y con el hosting (PI-010).
ARIS_MAX_UPLOAD_KB=10240

# Sin servicios de IA, analítica ni CDN obligatorios en el MVP.
