diff --git a/tests/Feature/Guides/GuideVersionConcurrencyTest.php b/tests/Feature/Guides/GuideVersionConcurrencyTest.php
index 0000000..1f8b73f
--- /dev/null
+++ b/tests/Feature/Guides/GuideVersionConcurrencyTest.php
@@ -0,0 +1,177 @@
+<?php
+
+namespace Tests\Feature\Guides;
+
+use App\Actions\Guides\SaveGuideVersion;
+use App\Actions\Guides\UpdateGuideVersion;
+use App\Models\Activity;
+use App\Models\ActivityVersion;
+use App\Models\Institution;
+use App\Models\InstitutionMembership;
+use App\Models\Project;
+use App\Models\Role;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+use Tests\TestCase;
+
+/**
+ * P2.3: control de concurrencia optimista en la edición de guías. La revisión esperada
+ * (lock_version) se comprueba dentro de la transacción; un formulario obsoleto no sobrescribe
+ * cambios válidos. Una versión publicada sigue siendo inmutable: editarla genera un borrador
+ * nuevo sin alterar la original.
+ */
+class GuideVersionConcurrencyTest extends TestCase
+{
+    use RefreshDatabase;
+
+    private User $autor;
+
+    private ActivityVersion $version;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->institution = Institution::create(['name' => 'Institución', 'status' => 'activa']);
+        $this->autor = User::factory()->create();
+        // El autor es administrador de la institución para pasar la política de actualización de guías.
+        $membresiaAutor = InstitutionMembership::create([
+            'institution_id' => $this->institution->id,
+            'user_id' => $this->autor->id,
+            'joined_at' => today(),
+            'status' => 'activa',
+        ]);
+        $membresiaAutor->roles()->attach(Role::firstOrCreate(['code' => 'administrador'], ['name' => 'Administrador']));
+        $this->project = Project::create([
+            'institution_id' => $this->institution->id,
+            'code' => 'ACT-1',
+            'slug' => 'act-1',
+            'title' => 'Proyecto',
+            'owner_id' => $this->autor->id,
+        ]);
+        $actividad = Activity::create([
+            'project_id' => $this->project->id,
+            'code' => 'ACT',
+            'title' => 'Actividad',
+            'created_by' => $this->autor->id,
+        ]);
+        $this->version = ActivityVersion::create([
+            'activity_id' => $actividad->id,
+            'version_number' => 1,
+            'title' => 'Título original',
+            'content' => 'Contenido original',
+            'author_id' => $this->autor->id,
+            'checksum' => hash('sha256', 'Contenido original'),
+            'status' => 'borrador',
+        ]);
+    }
+
+    public function test_editar_borrador_con_revision_coincidente_actualiza_e_incrementa(): void
+    {
+        $resultado = (new UpdateGuideVersion)->execute($this->version, [
+            'lock_version' => $this->version->lock_version,
+            'title' => 'Título corregido',
+            'content' => 'Contenido corregido',
+        ], $this->autor);
+
+        $this->assertSame('Título corregido', $resultado->title);
+        $this->assertSame('Contenido corregido', $resultado->content);
+        $this->assertSame(2, $resultado->lock_version);
+        $this->assertSame(hash('sha256', 'Contenido corregido'), $resultado->fresh()->checksum);
+    }
+
+    public function test_formulario_obsoleto_no_sobrescribe_cambios_validos(): void
+    {
+        // Primera edición válida incrementa la revisión a 2.
+        (new UpdateGuideVersion)->execute($this->version, [
+            'lock_version' => $this->version->lock_version,
+            'content' => 'Primera edición',
+        ], $this->autor);
+
+        // Un segundo formulario que aún trae la revisión 1 está obsoleto.
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('modificada por otro usuario');
+
+        (new UpdateGuideVersion)->execute($this->version, [
+            'lock_version' => 1,
+            'content' => 'Edición obsoleta que debe rechazarse',
+        ], $this->autor);
+
+        $this->assertSame('Primera edición', $this->version->fresh()->content);
+    }
+
+    public function test_editar_version_publicada_crea_borrador_nuevo_y_no_altera_la_publicada(): void
+    {
+        $publicada = ActivityVersion::create([
+            'activity_id' => $this->version->activity_id,
+            'version_number' => 2,
+            'title' => 'Publicada',
+            'content' => 'Contenido publicado',
+            'author_id' => $this->autor->id,
+            'checksum' => hash('sha256', 'Contenido publicado'),
+            'status' => 'publicada',
+            'published_at' => now(),
+            'lock_version' => 1,
+        ]);
+
+        $nueva = (new UpdateGuideVersion)->execute($publicada, [
+            'lock_version' => $publicada->lock_version,
+            'title' => 'Título corregido',
+            'content' => 'Contenido corregido',
+        ], $this->autor);
+
+        $this->assertNotSame($publicada->id, $nueva->id);
+        $this->assertSame(3, $nueva->version_number);
+        $this->assertSame('borrador', $nueva->status);
+        $this->assertSame(1, $nueva->lock_version);
+        // La publicada permanece intacta.
+        $this->assertSame('publicada', $publicada->fresh()->status);
+        $this->assertSame('Contenido publicado', $publicada->fresh()->content);
+    }
+
+    public function test_save_guide_version_con_lock_version_obsoleto_es_rechazado(): void
+    {
+        // Primera edición válida incrementa la revisión.
+        (new SaveGuideVersion)->execute($this->autor, $this->version, [
+            'lock_version' => $this->version->lock_version,
+            'title' => 'Título original',
+            'content' => 'Primera edición válida',
+        ]);
+
+        // Segundo intento con lock_version obsoleto (1) debe rechazarse.
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('modificada por otro usuario');
+
+        (new SaveGuideVersion)->execute($this->autor, $this->version, [
+            'lock_version' => 1,
+            'title' => 'Título',
+            'content' => 'Edición obsoleta que debe rechazarse',
+        ]);
+
+        $this->assertSame('Primera edición válida', $this->version->fresh()->content);
+    }
+
+    public function test_despues_de_conflicto_lock_version_formulario_muestra_revision_actual_del_servidor(): void
+    {
+        $this->actingAs($this->autor);
+
+        // Primera edición válida: lock_version pasa de 1 a 2.
+        $this->patch(route('guias.update', $this->version), [
+            'lock_version' => $this->version->lock_version,
+            'title' => 'Título original',
+            'content' => 'Primera edición válida',
+        ])->assertRedirect();
+
+        // Segundo intento con lock_version obsoleto (1): conflicto de revisión.
+        $respuesta = $this->patch(route('guias.update', $this->version), [
+            'lock_version' => 1,
+            'title' => 'Título obsoleto',
+            'content' => 'Contenido obsoleto',
+        ]);
+
+        $respuesta->assertSessionHasErrors('lock_version');
+        // El formulario debe flash la revisión actual del servidor (2).
+        $this->assertSame(2, session('guias.lock_version'));
+    }
+}

diff --git a/tests/Feature/Identity/ManageInstitutionRoleTest.php b/tests/Feature/Identity/ManageInstitutionRoleTest.php
index 0000000..81d954d
--- /dev/null
+++ b/tests/Feature/Identity/ManageInstitutionRoleTest.php
@@ -0,0 +1,145 @@
+<?php
+
+namespace Tests\Feature\Identity;
+
+use App\Actions\Identity\ManageInstitutionRole;
+use App\Models\Institution;
+use App\Models\InstitutionMembership;
+use App\Models\Role;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+use Tests\Support\AcademicScenario;
+use Tests\TestCase;
+
+/**
+ * P1.2: no se puede retirar el último administrador vigente de una institución. La comprobación
+ * adquiere un bloqueo transaccional por institución y usa InstitutionalAuthority como criterio
+ * de autoridad efectiva (usuario, institución y membresía vigentes).
+ */
+class ManageInstitutionRoleTest extends TestCase
+{
+    use AcademicScenario, RefreshDatabase;
+
+    private Institution $institution;
+
+    private User $admin;
+
+    private InstitutionMembership $adminMembership;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->institution = Institution::create(['name' => 'Institución de prueba', 'status' => 'activa']);
+        $this->admin = $this->member($this->institution, 'administrador');
+        $this->adminMembership = $this->admin->institutionMemberships()->firstOrFail();
+    }
+
+    private function administrador(User $user, array $overrides = []): InstitutionMembership
+    {
+        $membership = InstitutionMembership::create(array_merge([
+            'institution_id' => $this->institution->id,
+            'user_id' => $user->id,
+            'joined_at' => today(),
+        ], $overrides));
+        $membership->roles()->attach(Role::firstOrCreate(['code' => 'administrador'], ['name' => 'Administrador']));
+
+        return $membership;
+    }
+
+    public function test_rechaza_retirar_el_unico_administrador_vigente(): void
+    {
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('último administrador vigente');
+
+        (new ManageInstitutionRole)->execute($this->admin, $this->adminMembership, 'administrador', false);
+    }
+
+    public function test_permite_retirar_un_administrador_si_queda_otro_vigente(): void
+    {
+        $otro = User::factory()->create();
+        $membresiaOtro = InstitutionMembership::create([
+            'institution_id' => $this->institution->id,
+            'user_id' => $otro->id,
+            'joined_at' => today(),
+        ]);
+        $membresiaOtro->roles()->attach(Role::firstOrCreate(['code' => 'administrador'], ['name' => 'Administrador']));
+
+        // No debe lanzar: al actor (administrador) le queda al menos otro administrador vigente.
+        (new ManageInstitutionRole)->execute($this->admin, $membresiaOtro, 'administrador', false);
+
+        $this->assertDatabaseMissing('membership_roles', [
+            'institution_membership_id' => $membresiaOtro->id,
+            'role_id' => Role::where('code', 'administrador')->firstOrFail()->id,
+        ]);
+    }
+
+    public function test_no_cuentan_administradores_inactivos(): void
+    {
+        $inactivo = User::factory()->create(['status' => 'inactivo']);
+        $this->administrador($inactivo);
+
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('último administrador vigente');
+
+        // El actor es el único administrador efectivo; el inactivo no cuenta.
+        (new ManageInstitutionRole)->execute($this->admin, $this->adminMembership, 'administrador', false);
+    }
+
+    public function test_no_cuentan_membresias_vencidas(): void
+    {
+        $vencido = User::factory()->create();
+        $this->administrador($vencido, ['left_at' => today()->subDay()]);
+
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('último administrador vigente');
+
+        (new ManageInstitutionRole)->execute($this->admin, $this->adminMembership, 'administrador', false);
+    }
+
+    public function test_aislamiento_entre_instituciones(): void
+    {
+        $otra = Institution::create(['name' => 'Otra institución', 'status' => 'activa']);
+        $otroAdmin = $this->member($otra, 'administrador');
+        $otraMembresia = $otroAdmin->institutionMemberships()->firstOrFail();
+
+        $this->expectException(AuthorizationException::class);
+        // El actor no es administrador de la otra institución.
+        (new ManageInstitutionRole)->execute($this->admin, $otraMembresia, 'administrador', false);
+    }
+
+    public function test_retirar_un_rol_que_no_es_administrador_no_desencadena_proteccion(): void
+    {
+        $evaluador = $this->member($this->institution, 'aprendiz');
+        $membresia = $evaluador->institutionMemberships()->firstOrFail();
+        $membresia->roles()->attach(Role::firstOrCreate(['code' => 'evaluador'], ['name' => 'Evaluador']));
+
+        // Puede quitarse el rol de evaluador sin afectar al único administrador.
+        (new ManageInstitutionRole)->execute($this->admin, $membresia, 'evaluador', false);
+
+        $this->assertDatabaseMissing('membership_roles', [
+            'institution_membership_id' => $membresia->id,
+            'role_id' => Role::where('code', 'evaluador')->firstOrFail()->id,
+        ]);
+    }
+
+    public function test_no_cuentan_administrador_con_membresia_inactiva(): void
+    {
+        $otroAdmin = User::factory()->create();
+        $membresiaOtro = InstitutionMembership::create([
+            'institution_id' => $this->institution->id,
+            'user_id' => $otroAdmin->id,
+            'joined_at' => today(),
+            'status' => 'inactiva',
+        ]);
+        $membresiaOtro->roles()->attach(Role::firstOrCreate(['code' => 'administrador'], ['name' => 'Administrador']));
+
+        $this->expectException(ValidationException::class);
+        $this->expectExceptionMessage('último administrador vigente');
+
+        // El actor es el único administrador efectivo; el otro tiene membresía inactiva.
+        (new ManageInstitutionRole)->execute($this->admin, $this->adminMembership, 'administrador', false);
+    }
+}

diff --git a/tests/Feature/Storage/EvidenceValidatorOoxmlTest.php b/tests/Feature/Storage/EvidenceValidatorOoxmlTest.php
index 0000000..aaff4c6
--- /dev/null
+++ b/tests/Feature/Storage/EvidenceValidatorOoxmlTest.php
@@ -0,0 +1,184 @@
+<?php
+
+namespace Tests\Feature\Storage;
+
+use App\Exceptions\InvalidEvidence;
+use App\Services\Storage\EvidenceValidator;
+use Illuminate\Http\UploadedFile;
+use Tests\TestCase;
+
+/**
+ * P2.2: la firma ZIP no es suficiente para DOCX/XLSX. Se valida la estructura OOXML
+ * (partes obligatorias, tipo de contenido y relaciones) sin extraer indiscriminadamente,
+ * rechazando ZIP genéricos, extensiones cruzadas, archivos corruptos y paquetes que
+ * excedan límites defensivos.
+ */
+class EvidenceValidatorOoxmlTest extends TestCase
+{
+    public function test_documento_word_valido_pasa_validacion(): void
+    {
+        $validator = new EvidenceValidator;
+        $archivo = $this->archivo($this->empaquetar($this->partesDocx()), 'informe.docx');
+
+        $resultado = $validator->validate($archivo);
+
+        $this->assertSame('docx', $resultado['extension']);
+        $this->assertSame('informe.docx', $resultado['original_name']);
+        $this->assertStringStartsWith('application/vnd.openxmlformats-officedocument', $resultado['mime']);
+    }
+
+    public function test_hoja_de_calculo_valida_pasa_validacion(): void
+    {
+        $validator = new EvidenceValidator;
+        $archivo = $this->archivo($this->empaquetar($this->partesXlsx()), 'datos.xlsx');
+
+        $resultado = $validator->validate($archivo);
+
+        $this->assertSame('xlsx', $resultado['extension']);
+        $this->assertSame('datos.xlsx', $resultado['original_name']);
+    }
+
+    public function test_zip_generico_sin_estructura_ooxml_es_rechazado_como_docx(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+        $contenido = $this->empaquetar(['readme.txt' => 'hola mundo']);
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo($contenido, 'falso.docx'));
+    }
+
+    public function test_archivo_corrupto_es_rechazado(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo('no es un zip valido', 'corrupto.docx'));
+    }
+
+    public function test_extension_cruzada_estructura_xlsx_con_nombre_docx_es_rechazada(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo($this->empaquetar($this->partesXlsx()), 'falso.docx'));
+    }
+
+    public function test_docx_sin_parte_principal_es_rechazado(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+        $validator = new EvidenceValidator;
+        $partes = $this->partesDocx();
+        unset($partes['word/document.xml']);
+        $validator->validate($this->archivo($this->empaquetar($partes), 'incompleto.docx'));
+    }
+
+    public function test_pdf_jpg_png_siguen_validandose_por_magia_de_bytes(): void
+    {
+        $validator = new EvidenceValidator;
+
+        $pdf = $this->archivo("%PDF-1.4\n1 0 obj\n<< /Type /Catalog >>\nendobj\nxref\n0 2\n0000000000 65535 f \n0000000009 00000 n \ntrailer\n<< /Size 2 /Root 1 0 R >>\nstartxref\n56\n%%EOF", 'documento.pdf');
+        $this->assertSame('pdf', $validator->validate($pdf)['extension']);
+
+        $jpg = $this->archivo("\xFF\xD8\xFF\xE0\x00\x10JFIF\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00\xFF\xD9", 'foto.jpg');
+        $this->assertSame('jpg', $validator->validate($jpg)['extension']);
+
+        $png = $this->archivo("\x89PNG\r\n\x1A\n\x00\x00\x00\rIHDR\x00\x00\x00\x01\x00\x00\x00\x01\x08\x06\x00\x00\x00\x1f\x15\xc4\x89", 'imagen.png');
+        $this->assertSame('png', $validator->validate($png)['extension']);
+    }
+
+    public function test_paquete_con_demasiadas_entradas_es_rechazado(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+        $partes = [];
+        for ($i = 0; $i < 3001; $i++) {
+            $partes["archivo{$i}.txt"] = str_repeat('x', 100);
+        }
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo($this->empaquetar($partes), 'bomba.docx'));
+    }
+
+    public function test_content_types_xml_mal_formado_no_genera_500_se_rechaza_como_invalido(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+
+        $partes = $this->partesDocx();
+        // XML mal formado: etiqueta de cierre faltante en el Override.
+        $partes['[Content_Types].xml'] = '<Types>
+  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
+  <Default Extension="xml" ContentType="application/xml"/>
+  <Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"
+</Types>';
+
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo($this->empaquetar($partes), 'malformado.docx'));
+    }
+
+    public function test_relacion_sin_tipo_office_document_correcto_es_rechazada(): void
+    {
+        $this->expectException(InvalidEvidence::class);
+
+        $partes = $this->partesDocx();
+        // La relación apunta a la parte principal pero su Type no es officeDocument.
+        $partes['_rels/.rels'] = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
+  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/package/2006/relationships/metadata" Target="word/document.xml"/>
+</Relationships>';
+
+        $validator = new EvidenceValidator;
+        $validator->validate($this->archivo($this->empaquetar($partes), 'tipo-incorrecto.docx'));
+    }
+
+    private function partesDocx(): array
+    {
+        return [
+            '[Content_Types].xml' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
+  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
+  <Default Extension="xml" ContentType="application/xml"/>
+  <Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>
+</Types>',
+            '_rels/.rels' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
+  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>
+</Relationships>',
+            'word/document.xml' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p></w:p></w:body></w:document>',
+        ];
+    }
+
+    private function partesXlsx(): array
+    {
+        return [
+            '[Content_Types].xml' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
+  <Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>
+  <Default Extension="xml" ContentType="application/xml"/>
+  <Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>
+</Types>',
+            '_rels/.rels' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
+  <Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>
+</Relationships>',
+            'xl/workbook.xml' => '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
+<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheets><sheet name="Hoja1" sheetId="1" state="visible"/></sheets></workbook>',
+        ];
+    }
+
+    private function empaquetar(array $partes): string
+    {
+        $ruta = tempnam(sys_get_temp_dir(), 'oxml_');
+        $zip = new \ZipArchive;
+        $zip->open($ruta, \ZipArchive::CREATE | \ZipArchive::OVERWRITE);
+        foreach ($partes as $nombre => $contenido) {
+            $zip->addFromString($nombre, $contenido);
+        }
+        $zip->close();
+
+        return file_get_contents($ruta);
+    }
+
+    private function archivo(string $contenido, string $nombre): UploadedFile
+    {
+        $ruta = tempnam(sys_get_temp_dir(), 'aris_');
+        file_put_contents($ruta, $contenido);
+
+        return new UploadedFile($ruta, $nombre, null, null, true);
+    }
+}

diff --git a/tests/Feature/Submissions/SearchOptionalFiltersTest.php b/tests/Feature/Submissions/SearchOptionalFiltersTest.php
index 0000000..9497920
--- /dev/null
+++ b/tests/Feature/Submissions/SearchOptionalFiltersTest.php
@@ -0,0 +1,59 @@
+<?php
+
+namespace Tests\Feature\Submissions;
+
+use App\Models\Institution;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\AcademicScenario;
+use Tests\TestCase;
+
+/**
+ * P2.1: el buscador de entregas debe aceptar campos opcionales vacíos tal como los envían
+ * los formularios HTML reales, sin debilitar la validación de valores no vacíos.
+ */
+class SearchOptionalFiltersTest extends TestCase
+{
+    use AcademicScenario, RefreshDatabase;
+
+    private function urlConFiltros(array $filtros): string
+    {
+        return '/entregas/buscar?'.http_build_query($filtros);
+    }
+
+    public function test_todos_los_campos_opcionales_vacios_devuelven_200(): void
+    {
+        $institution = Institution::create(['name' => 'Institución', 'status' => 'activa']);
+        $user = $this->member($institution, 'aprendiz');
+
+        $this->actingAs($user)->get($this->urlConFiltros([
+            'q' => '', 'estado' => '', 'ficha_id' => '', 'desde' => '', 'hasta' => '',
+        ]))->assertOk();
+    }
+
+    public function test_cada_campo_opcional_vacio_por_separado_es_aceptado(): void
+    {
+        $institution = Institution::create(['name' => 'Institución', 'status' => 'activa']);
+        $user = $this->member($institution, 'aprendiz');
+
+        foreach ([
+            ['estado' => ''],
+            ['ficha_id' => ''],
+            ['desde' => ''],
+            ['hasta' => ''],
+            ['q' => ''],
+        ] as $filtro) {
+            $this->actingAs($user)->get($this->urlConFiltros($filtro))->assertOk();
+        }
+    }
+
+    public function test_filtro_por_ficha_combinado_con_campos_vacios_sigue_funcionando(): void
+    {
+        $institution = Institution::create(['name' => 'Institución', 'status' => 'activa']);
+        $user = $this->member($institution, 'aprendiz');
+        $ficha = $this->ficha($institution);
+
+        $this->actingAs($user)->get($this->urlConFiltros([
+            'q' => '', 'estado' => '', 'ficha_id' => $ficha->id, 'desde' => '', 'hasta' => '',
+        ]))->assertOk();
+    }
+}

diff --git a/tests/Feature/Submissions/SearchPerformanceTest.php b/tests/Feature/Submissions/SearchPerformanceTest.php
index 0000000..331d17d
--- /dev/null
+++ b/tests/Feature/Submissions/SearchPerformanceTest.php
@@ -0,0 +1,85 @@
+<?php
+
+namespace Tests\Feature\Submissions;
+
+use App\Models\Institution;
+use App\Models\Project;
+use App\Models\Submission;
+use App\Models\SubmissionVersion;
+use App\Queries\SearchSubmissions;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Tests\Support\AcademicScenario;
+use Tests\TestCase;
+
+/**
+ * P2.4: el buscador elimina consultas N+1 sobre versiones y conteos. Las versiones del
+ * proyecto se cargan con eager loading y la vista accede a la colección ya en memoria.
+ */
+class SearchPerformanceTest extends TestCase
+{
+    use AcademicScenario, RefreshDatabase;
+
+    public function test_acceso_a_versiones_de_resultados_no_genera_n_plus_1(): void
+    {
+        $institution = Institution::create(['name' => 'Institución', 'status' => 'activa']);
+        $admin = $this->member($institution, 'administrador');
+        $project = Project::create([
+            'institution_id' => $institution->id,
+            'code' => 'PROY',
+            'slug' => 'proy',
+            'title' => 'Proyecto',
+            'owner_id' => $admin->id,
+        ]);
+
+        $total = 8;
+        for ($i = 1; $i <= $total; $i++) {
+            $entrega = Submission::create([
+                'project_id' => $project->id,
+                'author_id' => $admin->id,
+                'title' => "Entrega $i",
+                'status' => 'borrador',
+            ]);
+            SubmissionVersion::create([
+                'submission_id' => $entrega->id,
+                'version_number' => 1,
+                'title' => "v1-$i",
+                'summary' => 'Resumen de prueba',
+                'content' => 'contenido',
+                'author_id' => $admin->id,
+                'checksum' => hash('sha256', 'contenido'),
+                'status' => 'borrador',
+            ]);
+            SubmissionVersion::create([
+                'submission_id' => $entrega->id,
+                'version_number' => 2,
+                'title' => "v2-$i",
+                'summary' => 'Resumen de prueba',
+                'content' => 'contenido',
+                'author_id' => $admin->id,
+                'checksum' => hash('sha256', 'contenido'),
+                'status' => 'borrador',
+            ]);
+        }
+
+        DB::enableQueryLog();
+        $resultados = app(SearchSubmissions::class)->forUser($admin, [])->get();
+        $consultasCarga = count(DB::getQueryLog());
+        DB::flushQueryLog();
+
+        foreach ($resultados as $entrega) {
+            // La vista solo necesita la última versión y el conteo, ya cargados.
+            $this->assertNotNull($entrega->latestVersion);
+            $this->assertSame(2, $entrega->versions_count);
+            $this->assertSame(2, $entrega->latestVersion->version_number);
+            $this->assertNotEmpty($entrega->project->title);
+        }
+        $consultasAcceso = count(DB::getQueryLog());
+
+        // La carga usa un número acotado de consultas (no una por entrega) y el acceso a
+        // relaciones precargadas no dispara consultas adicionales.
+        $this->assertLessThanOrEqual(6, $consultasCarga);
+        $this->assertSame(0, $consultasAcceso);
+        $this->assertSame($total, $resultados->count());
+    }
+}

diff --git a/tests/Feature/Submissions/SearchPrivacyTest.php b/tests/Feature/Submissions/SearchPrivacyTest.php
index 0000000..b777c3b
--- /dev/null
+++ b/tests/Feature/Submissions/SearchPrivacyTest.php
@@ -0,0 +1,187 @@
+<?php
+
+namespace Tests\Feature\Submissions;
+
+use App\Models\Activity;
+use App\Models\ActivityAssignment;
+use App\Models\ActivityVersion;
+use App\Models\Institution;
+use App\Models\InstitutionMembership;
+use App\Models\Project;
+use App\Models\ProjectMembership;
+use App\Models\Submission;
+use App\Models\User;
+use App\Queries\SearchSubmissions;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\AcademicScenario;
+use Tests\TestCase;
+
+/**
+ * PI-002 / P1.1: el buscador no debe mostrar entregas solo porque el usuario tenga acceso
+ * al proyecto. El alcance autorizado se comparte con SubmissionVersionPolicy::view:
+ * el autor ve sus propias entregas; el personal institucional (administrador, instructor,
+ * evaluador con jurisdicción vigente) ve las entregas de sus proyectos.
+ */
+class SearchPrivacyTest extends TestCase
+{
+    use AcademicScenario, RefreshDatabase;
+
+    private Institution $institution;
+
+    private Project $project;
+
+    private User $admin;
+
+    private User $instructor;
+
+    private User $author;
+
+    private User $companero;
+
+    private User $otraInstitucion;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->institution = Institution::create(['name' => 'Institución de prueba', 'status' => 'activa']);
+        $this->admin = $this->member($this->institution, 'administrador');
+        $this->instructor = $this->member($this->institution, 'instructor');
+        $this->author = $this->member($this->institution, 'aprendiz');
+        $this->companero = $this->member($this->institution, 'aprendiz');
+        $this->otraInstitucion = $this->member(
+            Institution::create(['name' => 'Otra institución', 'status' => 'activa']),
+            'aprendiz'
+        );
+
+        $this->project = $this->project($this->ficha($this->institution), $this->admin);
+        $this->project->update(['status' => 'activo']);
+
+        // Todos son miembros del proyecto con rol aprendiz.
+        foreach ([$this->author, $this->companero] as $user) {
+            ProjectMembership::create([
+                'project_id' => $this->project->id,
+                'user_id' => $user->id,
+                'function' => 'aprendiz',
+                'assigned_at' => today(),
+            ]);
+        }
+        // El instructor es tutor del proyecto (personal institucional).
+        ProjectMembership::create([
+            'project_id' => $this->project->id,
+            'user_id' => $this->instructor->id,
+            'function' => 'instructor',
+            'assigned_at' => today(),
+        ]);
+
+        $actividad = Activity::create([
+            'project_id' => $this->project->id,
+            'code' => 'ACT',
+            'title' => 'Actividad',
+            'created_by' => $this->admin->id,
+        ]);
+        $version = ActivityVersion::create([
+            'activity_id' => $actividad->id,
+            'version_number' => 1,
+            'title' => 'Guía',
+            'content' => 'Contenido',
+            'author_id' => $this->admin->id,
+            'checksum' => hash('sha256', 'Contenido'),
+            'status' => 'publicada',
+            'published_at' => now(),
+        ]);
+        ActivityAssignment::create([
+            'activity_version_id' => $version->id,
+            'project_id' => $this->project->id,
+            'status' => 'activa',
+            'target_type' => 'proyecto',
+            'target_ref' => (string) $this->project->id,
+            'assigned_at' => now(),
+            'assigned_by' => $this->admin->id,
+        ]);
+
+        Submission::create([
+            'project_id' => $this->project->id,
+            'author_id' => $this->author->id,
+            'title' => 'Entrega del autor',
+            'status' => 'borrador',
+        ]);
+        Submission::create([
+            'project_id' => $this->project->id,
+            'author_id' => $this->companero->id,
+            'title' => 'Entrega del compañero',
+            'status' => 'borrador',
+        ]);
+    }
+
+    private function buscar(User $user): array
+    {
+        return app(SearchSubmissions::class)->forUser($user, [])
+            ->orderByDesc('id')
+            ->get()
+            ->map(fn ($entrega) => $entrega->title)
+            ->toArray();
+    }
+
+    public function test_el_autor_solo_ve_su_propia_entrega(): void
+    {
+        $this->assertSame(['Entrega del autor'], $this->buscar($this->author));
+    }
+
+    public function test_un_aprendiz_no_ve_la_entrega_del_companero_del_mismo_proyecto(): void
+    {
+        $this->assertSame(['Entrega del compañero'], $this->buscar($this->companero));
+        $this->assertNotContains('Entrega del autor', $this->buscar($this->companero));
+    }
+
+    public function test_el_instructor_ve_las_entregas_de_su_proyecto(): void
+    {
+        $resultados = $this->buscar($this->instructor);
+        $this->assertContains('Entrega del autor', $resultados);
+        $this->assertContains('Entrega del compañero', $resultados);
+    }
+
+    public function test_el_administrador_ve_las_entregas_de_su_institucion(): void
+    {
+        $resultados = $this->buscar($this->admin);
+        $this->assertContains('Entrega del autor', $resultados);
+        $this->assertContains('Entrega del compañero', $resultados);
+    }
+
+    public function test_un_aprendiz_de_otra_institucion_no_ve_nada(): void
+    {
+        $this->assertSame([], $this->buscar($this->otraInstitucion));
+    }
+
+    public function test_un_miembro_sin_rol_institucional_no_ve_entregas_ajenas(): void
+    {
+        $sinRol = User::factory()->create();
+        InstitutionMembership::create([
+            'institution_id' => $this->institution->id,
+            'user_id' => $sinRol->id,
+            'joined_at' => today(),
+        ]);
+        ProjectMembership::create([
+            'project_id' => $this->project->id,
+            'user_id' => $sinRol->id,
+            'function' => 'aprendiz',
+            'assigned_at' => today(),
+        ]);
+
+        $this->assertSame([], $this->buscar($sinRol));
+    }
+
+    public function test_autor_con_membresia_expirada_no_ve_entregas_via_http(): void
+    {
+        // El autor tiene una entrega en el proyecto (creada en setUp).
+        // Expirar su membresía de aprendiz en el proyecto.
+        ProjectMembership::where('user_id', $this->author->id)
+            ->where('project_id', $this->project->id)
+            ->update(['ended_at' => today()->subDay()]);
+
+        $respuesta = $this->actingAs($this->author)->get(route('entregas.buscar'));
+
+        $respuesta->assertOk();
+        $respuesta->assertDontSee('Entrega del autor');
+    }
+}
