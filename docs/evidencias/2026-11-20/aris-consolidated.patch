diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0000000..de7d86b
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,89 @@
+name: CI — ARIS 2.0
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+jobs:
+  php-tests:
+    runs-on: ubuntu-latest
+    strategy:
+      fail-fast: false
+      matrix:
+        php: [8.4]
+        db: [sqlite, mysql]
+
+    services:
+      mysql:
+        if: matrix.db == 'mysql'
+        image: mysql:8.4
+        env:
+          MYSQL_ROOT_PASSWORD: password
+          MYSQL_DATABASE: aris_test_ci
+          MYSQL_USER: aris_ci
+          MYSQL_PASSWORD: password
+        ports:
+          - 3306:3306
+        options: >-
+          --health-cmd="mysqladmin ping -h localhost"
+          --health-interval=10s
+          --health-timeout=5s
+          --health-retries=5
+
+    steps:
+      - name: Checkout código
+        uses: actions/checkout@v4
+
+      - name: Instalar PHP ${{ matrix.php }} y extensiones
+        uses: shivammathur/setup-php@v2
+        with:
+          php-version: ${{ matrix.php }}
+          extensions: dom, curl, libxml, mbstring, zip, pcntl, pdo, sqlite3, pdo_mysql, gd, fileinfo, openssl, intl
+          coverage: none
+
+      - name: Instalar Composer y dependencias (desde lockfile)
+        run: |
+          composer install --no-interaction --prefer-dist --optimize-autoloader
+
+      - name: Instalar Node y dependencias frontend (desde lockfile)
+        uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+          cache: 'npm'
+          cache-dependency-path: '**/package-lock.json'
+        # Se ejecuta en un paso separado para no fallar si el registro no responde
+
+      - name: Compilar assets (Vite)
+        run: npm ci --ignore-scripts && npm run build
+
+      - name: Crear .env de prueba
+        run: |
+          cp .env.example .env
+          php artisan key:generate --ansi
+          if [ "${{ matrix.db }}" = "mysql" ]; then
+            sed -i 's/DB_CONNECTION=sqlite/DB_CONNECTION=mysql/' .env
+            sed -i 's/DB_HOST=127.0.0.1/DB_HOST=127.0.0.1/' .env
+            sed -i 's/DB_PORT=3306/DB_PORT=3306/' .env
+            sed -i 's/DB_DATABASE=aris_v2_db/DB_DATABASE=aris_test_ci/' .env
+            sed -i 's/DB_USERNAME=/DB_USERNAME=aris_ci/' .env
+            sed -i 's/DB_PASSWORD=/DB_PASSWORD=password/' .env
+          fi
+
+      - name: Ejecutar migraciones
+        run: php artisan migrate --force
+
+      - name: Ejecutar Pint (estilo PHP)
+        run: composer exec pint --test
+
+      - name: Ejecutar suite de pruebas (PHPUnit)
+        run: php artisan test
+
+      - name: Validar documentación (enlaces y rutas)
+        run: node scripts/verificar-enlaces-docs.mjs
+
+      - name: Verificar que no haya secretos versionados
+        run: |
+          if git ls-files | grep -E '^\.env(\.|$)' ; then exit 1; fi
+          if git ls-files | grep -E 'storage/app/private' ; then exit 1; fi

